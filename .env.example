# ── Supabase (สินค้า) ──
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (Project Settings → API)

# ค่าสาธารณะ (ฝั่งเบราว์เซอร์) — อ่านสินค้า
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key...

# ค่าลับ (ฝั่งเซิร์ฟเวอร์) — เขียนสินค้าผ่าน API route (หลังตรวจแอดมินแล้ว)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...

# ── Firebase (ล็อกอินแอดมิน — ตรวจกับ collection employees2 ฝั่งเซิร์ฟเวอร์) ──
# นำ service account JSON (Firebase Console → Project Settings → Service accounts → Generate new private key)
# มาแปลงเป็น base64 บรรทัดเดียว:  base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=ewog...base64-ของ-service-account-json...

# ชื่อ collection พนักงาน (ค่าเริ่มต้น employees2) และ role ที่ถือเป็นแอดมิน
ADMIN_EMPLOYEE_COLLECTION=employees2
ADMIN_ROLE_VALUE=Administrator

# ── ความลับสำหรับเซ็นคุกกี้ session แอดมิน (สุ่มยาว ๆ) ──
# สร้างด้วย:  openssl rand -hex 32
ADMIN_SESSION_SECRET=สุ่มค่ายาวอย่างน้อย-32-ตัวอักษร

# ── แชทหน้าเว็บ (หน้าแรก) → ผู้ช่วย AI ตัวเดียวกับหน้าแชทของ AdminBuddy (chat.html) ──
# ไม่ตั้งก็ได้ ระบบใช้ค่าเดียวกับที่ chat.html เรียกอยู่เป็นค่าเริ่มต้น
CHAT_WEBHOOK_URL=https://n8n.iduckybot.com/webhook/knowledge-chat
