/**
 * ตรวจแพทเทิร์นบรรทัดรายละเอียดงานกระดาษ + การยุบคู่ช่อง กว้าง/สูง ของ "กำหนดขนาดเอง" (tidySpec ใน SpecLines.tsx)
 * กราฟฟิกขอ 18 ก.ย. 69 (OD-260917-6834) — เรียกฟังก์ชันจริงที่ทุกจอใช้ ไม่แตะ DB
 *   npx tsx scripts/spec-lines-paper-check.mts
 */
import { tidySpec, specEntries } from "../src/components/SpecLines";

let fail = 0;
const ok = (name: string, pass: boolean, extra = "") => { if (!pass) fail++; console.log(pass ? "  ✅" : "  ❌", name, extra); };
const lines = (e: [string, string][]) => e.map(([k, v]) => `${k}: ${v}`);
const same = (a: string[], b: string[]) => JSON.stringify(a) === JSON.stringify(b);
const show = (a: string[]) => "\n      " + a.join("\n      ");

// ─── 1) OD-260917-6834 — คีย์เรียงแบบ jsonb (สั้นก่อน · "สูง" มาก่อน "กว้าง") ───
const od6834: Record<string, string> = {
  "มุม": "มุมมน",
  "ขนาดตัด": "📐 กำหนดขนาดเอง (ระบุ ก.×ส.)",
  "เรทราคา": "ตัดตามขนาด",
  "จำนวนลาย": "1 ลาย",
  "หมายเหตุ": "*ถ่ายรูปส่งดูงานจริงก่อนจะสั่งเพิ่ม",
  "ชนิดกระดาษ": "กระดาษอาร์ตมัน 300 แกรม",
  "ขนาดตัด (สูง)": "12.7 ซม.",
  "ขนาดตัด (กว้าง)": "8 ซม.",
  "จำนวนด้านที่พิมพ์": "พิมพ์ 1 ด้าน",
  "เคลือบ (เฉพาะด้านหน้า)": "ไม่เคลือบ",
};
console.log("1) OD-260917-6834 จอฝ่ายผลิต (compact · เรทราคาถูกซ่อนโดย SEL_HIDE_PRODUCTION ก่อนถึง tidySpec)");
const prod = lines(tidySpec(specEntries(od6834, undefined, ["เรทราคา"]), { compact: true }));
const wantProd = [
  "ชนิดกระดาษ: กระดาษอาร์ตมัน 300 แกรม (มุมมน)",
  "ขนาดตัด: กว้าง 8 × สูง 12.7 ซม.",
  "จำนวนด้านที่พิมพ์: พิมพ์ 1 ด้าน",
  "เคลือบ (เฉพาะด้านหน้า): ไม่เคลือบ",
  "จำนวนลาย: 1 ลาย",
  "หมายเหตุ: *ถ่ายรูปส่งดูงานจริงก่อนจะสั่งเพิ่ม",
];
ok("แพทเทิร์นตรงภาพกราฟฟิก (กระดาษ+มุม → ขนาดตัดบรรทัดเดียว → ด้าน → เคลือบ → จำนวนลาย → หมายเหตุ)", same(prod, wantProd), show(prod));

console.log("2) OD-260917-6834 หน้าลูกค้า/ใบเสร็จ (ไม่ compact · เห็นเรทราคา)");
const cust = lines(tidySpec(specEntries(od6834)));
const wantCust = [
  "ขนาดตัด: กว้าง 8 × สูง 12.7 ซม.",
  "ชนิดกระดาษ: กระดาษอาร์ตมัน 300 แกรม",
  "มุม: มุมมน",
  "จำนวนด้านที่พิมพ์: พิมพ์ 1 ด้าน",
  "เคลือบ (เฉพาะด้านหน้า): ไม่เคลือบ",
  "เรทราคา: ตัดตามขนาด",
  "จำนวนลาย: 1 ลาย",
  "หมายเหตุ: *ถ่ายรูปส่งดูงานจริงก่อนจะสั่งเพิ่ม",
];
ok("ขนาดก่อน → ชนิดกระดาษ (วัสดุ) → มุม → … → ท้ายการ์ด", same(cust, wantCust), show(cust));

console.log("3) ออเดอร์เก่า (กางจากข้อความรวม) ได้ผลเดียวกับ sel");
const text = "ชนิดกระดาษ: กระดาษอาร์ตมัน 300 แกรม · ขนาดตัด: 📐 กำหนดขนาดเอง (ระบุ ก.×ส.) · ขนาดตัด (กว้าง): 8 ซม. · ขนาดตัด (สูง): 12.7 ซม. · มุม: มุมมน · จำนวนด้านที่พิมพ์: พิมพ์ 1 ด้าน · เคลือบ (เฉพาะด้านหน้า): ไม่เคลือบ · เรทราคา: ตัดตามขนาด · จำนวนลาย: 1 ลาย · หมายเหตุ: *ถ่ายรูปส่งดูงานจริงก่อนจะสั่งเพิ่ม";
const fromText = lines(tidySpec(specEntries(undefined, text)));
ok("ข้อความรวม → บรรทัดเดียวกัน", same(fromText, wantCust), show(fromText));

// ─── 4) ไดคัทตามทรง (OD-260917-8043 · PET) ───
console.log("4) ไดคัทตามทรง PET — ตัวแม่ '📐 ระบุขนาดเอง (กรอกด้านล่าง)'");
const pet: [string, string][] = [
  ["ชนิดกระดาษ", "พลาสติก PET 250 แกรม"], ["วัสดุ PET", "สีใส"], ["รองขาว", "รองขาว"],
  ["ขนาดไดคัท", "📐 ระบุขนาดเอง (กรอกด้านล่าง)"], ["ขนาดไดคัท (สูง)", "8.5 ซม."], ["ขนาดไดคัท (กว้าง)", "5.83 ซม."],
  ["จำนวนด้านที่พิมพ์", "พิมพ์ 1 ด้าน"], ["เคลือบ (เฉพาะด้านหน้า)", "ไม่เคลือบ"], ["จำนวนลาย", "1 ลาย"],
];
const petProd = lines(tidySpec(pet, { compact: true }));
ok("ขนาดไดคัท: กว้าง 5.83 × สูง 8.5 ซม. + กระดาษขึ้นก่อน", same(petProd, [
  "ชนิดกระดาษ: พลาสติก PET 250 แกรม",
  "ขนาดไดคัท: กว้าง 5.83 × สูง 8.5 ซม.",
  "วัสดุ PET: สีใส",
  "รองขาว: รองขาว",
  "จำนวนด้านที่พิมพ์: พิมพ์ 1 ด้าน",
  "เคลือบ (เฉพาะด้านหน้า): ไม่เคลือบ",
  "จำนวนลาย: 1 ลาย",
]), show(petProd));

// ─── 5) พวงกุญแจหลายชิ้น — ตัวแม่ "ขนาดชิ้นที่ 2" · ลูก "ขนาดกำหนดเอง (กว้าง) ชิ้นที่ 2" ───
console.log("5) พวงหลายชิ้น จับคู่ด้วย 'ชิ้นที่ N'");
const charm: [string, string][] = [
  ["ขนาดชิ้นที่ 1", "3cm"], ["ขนาดชิ้นที่ 2", "📐 กำหนดขนาดเอง (ระบุ ก.×ส.)"],
  ["ขนาดกำหนดเอง (สูง) ชิ้นที่ 2", "2 ซม."], ["ขนาดกำหนดเอง (กว้าง) ชิ้นที่ 2", "3.5 ซม."], ["จำนวนลาย", "1 ลาย"],
];
const charmOut = lines(tidySpec(charm));
ok("ชิ้นที่ 1 คงเดิม · ชิ้นที่ 2 ยุบเป็น กว้าง 3.5 × สูง 2 ซม.", same(charmOut, [
  "ขนาดชิ้นที่ 1: 3cm", "ขนาดชิ้นที่ 2: กว้าง 3.5 × สูง 2 ซม.", "จำนวนลาย: 1 ลาย",
]), show(charmOut));

// ─── 6) กรอกด้านยาวสุดช่องเดียว (สแตนดี้/พวงกุญแจ) ───
console.log("6) กรอกด้านเดียว");
const longest: [string, string][] = [
  ["ขนาดตัวสแตนดี้", "📐 กำหนดขนาดเอง (ระบุด้านที่ยาวที่สุด)"], ["ขนาดกำหนดเอง (ด้านที่ยาวที่สุด)", "12 ซม."], ["สีอะคริลิค", "อะคริลิคใส"],
];
const longestOut = lines(tidySpec(longest));
ok("ขนาดตัวสแตนดี้: ยาวสุด 12 ซม.", same(longestOut, ["ขนาดตัวสแตนดี้: ยาวสุด 12 ซม.", "สีอะคริลิค: อะคริลิคใส"]), show(longestOut));

// ─── 7) ไม่มีตัวแม่ (ป้ายไวนิล "ขนาดป้าย (กว้าง)/(สูง)") ───
console.log("7) ไม่มีตัวแม่ → บรรทัดรวมยืนที่ลูกตัวแรก ใช้ชื่อฐาน");
const banner: [string, string][] = [["วัสดุ", "ไวนิล"], ["ขนาดป้าย (สูง)", "50 ซม."], ["ขนาดป้าย (กว้าง)", "100 ซม."], ["จำนวนลาย", "1 ลาย"]];
const bannerOut = lines(tidySpec(banner));
ok("ขนาดป้าย: กว้าง 100 × สูง 50 ซม.", same(bannerOut, ["ขนาดป้าย: กว้าง 100 × สูง 50 ซม.", "วัสดุ: ไวนิล", "จำนวนลาย: 1 ลาย"]), show(bannerOut));

// ─── 8) กรอกไม่ครบ / หน่วยต่างกัน ───
console.log("8) เคสขอบ");
const half = lines(tidySpec([["ขนาดตัด", "📐 กำหนดขนาดเอง (ระบุ ก.×ส.)"], ["ขนาดตัด (กว้าง)", "8 ซม."]]));
ok("มีแค่ด้านเดียว = ปล่อยไว้ตามเดิม", same(half, ["ขนาดตัด: 📐 กำหนดขนาดเอง (ระบุ ก.×ส.)", "ขนาดตัด (กว้าง): 8 ซม."]), show(half));
const units = lines(tidySpec([["ขนาดตัด", "📐 กำหนดขนาดเอง (ระบุ ก.×ส.)"], ["ขนาดตัด (กว้าง)", "8 ซม."], ["ขนาดตัด (สูง)", "5 นิ้ว"]]));
ok("หน่วยต่างกัน = เขียนหน่วยทั้งสองด้าน", same(units, ["ขนาดตัด: กว้าง 8 ซม. × สูง 5 นิ้ว"]), show(units));
const yao = lines(tidySpec([["ขนาด", "📐 กำหนดขนาดเอง (ระบุ ก.×ย.)"], ["ขนาดกำหนดเอง (ยาว)", "100 ซม."], ["ขนาดกำหนดเอง (กว้าง)", "15 ซม."]]));
ok("คู่ กว้าง/ยาว (ผ้าเชียร์) → กว้าง 15 × ยาว 100 ซม.", same(yao, ["ขนาด: กว้าง 15 × ยาว 100 ซม."]), show(yao));
const std = lines(tidySpec([["ขนาดตัด", "A4"], ["มุม", "มุมมน"], ["ชนิดกระดาษ", "กระดาษอาร์ตมัน 300 แกรม"]], { compact: true }));
ok("ขนาดมาตรฐาน (ไม่มีช่องกรอก) = ไม่แตะ · กระดาษ+มุมยังพับ", same(std, ["ชนิดกระดาษ: กระดาษอาร์ตมัน 300 แกรม (มุมมน)", "ขนาดตัด: A4"]), show(std));

// ─── 9) สินค้าอื่นไม่โดนกระทบ ───
console.log("9) งานสแตนดี้/อะคริลิค ไม่มีบรรทัดกระดาษ = แพทเทิร์นเดิม");
const standee: [string, string][] = [
  ["ทรงฐาน", "ทรงกลม"], ["ขนาดฐาน", "7cm"], ["สีอะคริลิค", "สีพิเศษ (โฮโลแกรม/กลิสเตอร์/สี)"], ["เลือกเฉดสีพิเศษ (ตัวสแตนดี้)", "hologram-01"],
  ["งานสกรีน", "สกรีน 1 ด้าน (บน)"], ["ขนาดตัวสแตนดี้", "15cm"], ["จำนวนลาย", "1 ลาย"],
];
const standeeOut = lines(tidySpec(standee, { compact: true }));
ok("บรรทัดแรกยังเป็นขนาดตัวสแตนดี้ · ไม่มีอะไรถูกพับเพิ่ม", standeeOut[0] === "ขนาดตัวสแตนดี้: 15cm" && standeeOut.length === 5, show(standeeOut));
const coat = lines(tidySpec([["ชนิดเคลือบ", "เงา"], ["สีอะคริลิค", "อะคริลิคใส"], ["ขนาด", "5cm"]]));
ok("'ชนิดเคลือบ' ไม่ถูกนับเป็นวัสดุ (ยังอยู่หลังสีอะคริลิค)", same(coat, ["ขนาด: 5cm", "สีอะคริลิค: อะคริลิคใส", "ชนิดเคลือบ: เงา"]), show(coat));
const cloth = lines(tidySpec([["ชนิดผ้า", "ผ้าซาติน"], ["จำนวนลาย", "1 ลาย"], ["ขนาด", "20x60 cm"]]));
ok("'ชนิดผ้า' = วัสดุ ขึ้นถัดจากขนาด", same(cloth, ["ขนาด: 20x60 cm", "ชนิดผ้า: ผ้าซาติน", "จำนวนลาย: 1 ลาย"]), show(cloth));

console.log(fail ? `\n❌ ไม่ผ่าน ${fail} ข้อ` : "\n✅ ผ่านทุกข้อ");
process.exit(fail ? 1 : 0);
