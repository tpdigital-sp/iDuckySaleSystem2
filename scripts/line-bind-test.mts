/**
 * 🔗 เทสกติกา "ยืม LINE / ห้องแชทจากใบเก่าของลูกค้าคนเดียวกัน" — npm run check:line-bind
 *
 * พนักงานแจ้ง 22 ก.ย. 69 (OD-260921-1336): "ลิงก์แชทที่ผูก กาออกไม่ได้ เหมือนจะผูกสลับคน"
 * ต้นเหตุ: เบอร์ 0834359322 มีลูกค้า 2 คน (คนละบัญชี LINE) — ใบของคนหนึ่งไปยืมห้องแชทของอีกคนมาโชว์
 * และเพราะเป็นลิงก์ "ของใบอื่น" ปุ่มลบจึงไม่ขึ้น · กดยกเลิกผูกคนก็เด้งชื่ออีกคนขึ้นมาแทนทันที
 *
 * ตรึงไว้ 3 เรื่อง: ยืมได้เฉพาะห้องของคนที่ผูกไว้ · ใบเก่าชี้คนละบัญชี = ไม่เดา · "ใบล่าสุด" ต้องวัดจากวันที่จริง
 */
import { lineChatOf, lineUserOf, type Order } from "../src/lib/admin-data";

let pass = 0;
const fails: string[] = [];
const eq = (name: string, got: unknown, want: unknown) => {
  if (JSON.stringify(got) === JSON.stringify(want)) pass++;
  else fails.push(`${name}\n   ได้ ${JSON.stringify(got)}\n   ควรได้ ${JSON.stringify(want)}`);
};

const mk = (o: Partial<Order>): Order =>
  ({
    id: "OD-260901-0001",
    date: "1 ก.ย. 2569 10:00",
    customer: "ลูกค้า",
    phone: "0834359322",
    address: "",
    status: "รอชำระเงิน",
    payment: "โอนธนาคาร",
    shipping: "ส่งธรรมดา",
    shippingCost: 0,
    items: [],
    ...o,
  }) as Order;

const room = (id: string) => `https://chat.line.biz/Uoa/chat/${id}`;

// ── เคสจริง: เบอร์เดียวกัน 2 คน ─────────────────────────────────────────────
// (เรียงแบบที่ API ส่งมา = ใหม่ → เก่า)
const ใบใหม่ = mk({ id: "OD-260921-1336", date: "21 ก.ย. 2569 14:48", customer: "อภิสิทธิ์", lineUserId: "Uaaa", lineProfile: { name: "อภิสิทธิ์", at: "" } });
const ใบเก่าคนเดียวกัน = mk({ id: "OD-260918-1604", date: "18 ก.ย. 2569 16:21", customer: "อภิสิทธิ์", lineUserId: "Uaaa", lineChatUrl: room("aaa") });
const ใบเก่าคนอื่น = mk({ id: "OD-260918-9798", date: "18 ก.ย. 2569 15:44", customer: "pathomyuth", lineUserId: "Ubbb", lineChatUrl: room("bbb") });
const all = [ใบใหม่, ใบเก่าคนเดียวกัน, ใบเก่าคนอื่น];

eq("ยืมห้องแชทจากใบที่ผูก LINE คนเดียวกัน (ไม่ใช่ใบของคนที่ใช้เบอร์ร่วมกัน)", lineChatOf(ใบใหม่, all), {
  url: room("aaa"),
  source: "prev",
  from: "OD-260918-1604",
});
// เดิมวนจากท้ายอาเรย์ทั้งที่อาเรย์เรียงใหม่→เก่า จึงได้ "ใบเก่าสุด" = ใบของคนอื่น
eq("ยืมห้องแชทได้ใบล่าสุดจริง ๆ", lineChatOf(ใบใหม่, all)?.from, "OD-260918-1604");

const ปลดผูกแล้ว = mk({ ...ใบใหม่, lineUserId: undefined, lineProfile: undefined });
eq("กดยกเลิกผูก + ใบเก่าชี้ LINE คนละบัญชี → ไม่เดาให้ (ต้องให้พนักงานผูกเอง)", lineUserOf(ปลดผูกแล้ว, [ปลดผูกแล้ว, ใบเก่าคนเดียวกัน, ใบเก่าคนอื่น]), null);
eq("ยังไม่รู้ว่าลูกค้าคือใคร + ใบเก่าชี้คนละห้อง → ไม่เดาห้องแชทให้", lineChatOf(ปลดผูกแล้ว, [ปลดผูกแล้ว, ใบเก่าคนเดียวกัน, ใบเก่าคนอื่น]), null);

// ── ของเดิมที่ต้องไม่พัง: ลูกค้าเก่าคนเดียวกันต้องยัง "จำ" ได้ ───────────────
const ไม่มีเบอร์ชนกัน = [ใบใหม่, ใบเก่าคนเดียวกัน];
const ใหม่ยังไม่ผูก = mk({ ...ใบใหม่, lineUserId: undefined, lineProfile: undefined });
eq("ใบเก่าของลูกค้าคนเดียวกันบัญชีเดียว → จำ LINE ให้เหมือนเดิม", lineUserOf(ใหม่ยังไม่ผูก, [ใหม่ยังไม่ผูก, ใบเก่าคนเดียวกัน])?.id, "Uaaa");
eq("ใบเก่าของลูกค้าคนเดียวกัน → จำห้องแชทให้เหมือนเดิม", lineChatOf(ใหม่ยังไม่ผูก, [ใหม่ยังไม่ผูก, ใบเก่าคนเดียวกัน])?.url, room("aaa"));
eq("ลิงก์ของใบนี้เองชนะเสมอ", lineChatOf(mk({ ...ใบใหม่, lineChatUrl: room("self") }), all), { url: room("self"), source: "self" });
// ใบเก่าที่มีแต่ลิงก์ (ยังไม่ได้ผูกใคร) ยังยืมได้ — ไม่ได้ขัดกับคนที่ผูกไว้
const ลิงก์ล้วน = mk({ id: "OD-260910-0002", date: "10 ก.ย. 2569 09:00", lineChatUrl: room("ccc") });
eq("ใบเก่าที่มีแต่ลิงก์ (ยังไม่ผูกใคร) ยืมได้", lineChatOf(ใบใหม่, [ใบใหม่, ลิงก์ล้วน])?.url, room("ccc"));
// คนละเบอร์/คนละคน = ไม่เกี่ยวกัน
const คนอื่นไปเลย = mk({ id: "OD-260919-0003", date: "19 ก.ย. 2569 09:00", phone: "0999999999", lineUserId: "Uccc", lineChatUrl: room("ddd") });
eq("คนละเบอร์ = ไม่ยืมข้ามกัน", lineChatOf(mk({ id: "OD-260920-0004", date: "20 ก.ย. 2569 09:00", phone: "0811111111" }), [คนอื่นไปเลย]), null);

// ── "ใบล่าสุด" ต้องวัดจากวันที่ ไม่ใช่ตำแหน่งในอาเรย์ ────────────────────────
// (คนเดียวกันแต่ลิงก์ห้องคนละอัน เช่นพนักงานวางลิงก์ใหม่ทีหลัง — ต้องได้อันที่วางไว้ในใบล่าสุด)
const เก่า = mk({ id: "OD-260901-0005", date: "1 ก.ย. 2569 09:00", lineUserId: "Uaaa", lineChatUrl: room("old") });
const ใหม่ = mk({ id: "OD-260915-0006", date: "15 ก.ย. 2569 09:00", lineUserId: "Uaaa", lineChatUrl: room("new") });
const ว่าง = mk({ id: "OD-260921-0007", date: "21 ก.ย. 2569 09:00", lineUserId: "Uaaa" });
eq("อาเรย์ใหม่→เก่า ได้ห้องของใบล่าสุด", lineChatOf(ว่าง, [ว่าง, ใหม่, เก่า])?.url, room("new"));
eq("อาเรย์เก่า→ใหม่ ก็ต้องได้ใบล่าสุดเหมือนกัน", lineChatOf(ว่าง, [เก่า, ใหม่, ว่าง])?.url, room("new"));
// ยังไม่ผูกใคร + ใบเก่าชี้คนละห้อง = เดาไม่ได้ (เคสเบอร์ร่วมกันข้างบน) — ต้องไม่หยิบมั่ว
eq("ไม่รู้ว่าใคร + 2 ห้องไม่ตรงกัน → ไม่เดา", lineChatOf(mk({ ...ว่าง, lineUserId: undefined }), [ว่าง, ใหม่, เก่า].map((o) => (o === ว่าง ? mk({ ...ว่าง, lineUserId: undefined }) : mk({ ...o, lineUserId: undefined })))), null);

console.log(fails.length ? `❌ ไม่ผ่าน ${fails.length} เคส (ผ่าน ${pass})\n\n${fails.join("\n\n")}` : `✅ ผ่านทั้งหมด ${pass} เคส`);
process.exit(fails.length ? 1 : 0);
