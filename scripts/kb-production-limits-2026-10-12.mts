/**
 * 🏭 นโยบายและข้อจำกัดในการผลิต (หน้าเว็บร้าน iduckyofficial-pricelists.com/productionlimitations · เจ้าของร้านส่งมา 12 ต.ค. 69)
 *   → คลังความรู้บอท แยกตามหัวข้อ (type "policy") ให้บอทค้นเจอทีละเรื่อง · ส่งเข้า n8n knowledge-ingest
 *   + เรื่องสี: ปรับข้อ "สีงานจริงจะตรงกับหน้าจอไหม" (เพิ่ม 12 ต.ค.) และ SRdPxx ให้ตรงหน้านโยบาย (เทียบไฟล์ ±5-15% · ต่างรอบ ±5-10%)
 *   รันซ้ำได้ (เช็คชื่อซ้ำ) · ใส่ --apply เพื่อบันทึก
 */
import { FieldValue } from "firebase-admin/firestore";
import { getChatFirestore } from "../src/lib/server/firebase-admin";
import { pushKnowledge } from "../src/lib/server/bot-kb";

const apply = process.argv.includes("--apply");
const db = getChatFirestore();
if (!db) throw new Error("ยังไม่ได้ตั้งค่า Firestore");
const col = db.collection("knowledge-base");
const SRC = "https://www.iduckyofficial-pricelists.com/productionlimitations";
const BY = { createdBy: "owner-policy", createdByName: "นโยบายข้อจำกัดการผลิต (12 ต.ค. 69)" };
const COLOR =
  "สีงานพิมพ์อาจสว่างขึ้นหรือดรอปลงจากไฟล์งานประมาณ ±5-15% ค่ะ (ทั้งงานพิมพ์ดิจิตอล กระดาษ/สติ๊กเกอร์ และ UV / Solvent / Sublimation ร้านพิมพ์ด้วยสี RGB) และการสั่งผลิตแต่ละรอบสีอาจต่างกันประมาณ ±5-10% เพราะความชื้น อุณหภูมิ และสภาพอากาศแต่ละวันมีผลกับเครื่องพิมพ์ การเคลือบลามิเนตก็ทำให้ภาพเข้มขึ้นหรืออ่อนลงได้ และบอกล่วงหน้าไม่ได้ว่าภาพไหนจะออกมาแบบไหน ถ้าต้องการสีที่แม่นมาก แนะนำสั่งเทสสีก่อนนะคะ";

const ADD: { title: string; content: string }[] = [
  { title: "ข้อจำกัดการผลิต: งานเคลมใช้ไฟล์ไหน รอยเล็กน้อยเคลมได้ไหม", content: "กรณีงานเคลม ร้านผลิตใหม่จากไฟล์เดิมเท่านั้นค่ะ และรอยขีดข่วน รอยขนแมว รอยจุด รอยเปื้อนเล็กน้อย หรือรอย/ฝุ่นในงานเคลือบเพียงเล็กน้อย ที่ไม่มีผลต่อการใช้งาน ร้านขอไม่รับเคลมนะคะ" },
  { title: "ข้อจำกัดการผลิต: ตำแหน่งลายแต่ละชิ้นไม่ตรงกัน งานวางมือ", content: "งานพิมพ์ UV งานซับลิเมชั่น งานติดกาว งานเย็บ งานปัก และงานที่ต้องใช้มือวางทีละชิ้น ตำแหน่งลายแต่ละชิ้นจะไม่ตรงกันเป๊ะ 100% ค่ะ คลาดเคลื่อนมากน้อยต่างกันไป แต่ไม่มีผลกับการใช้งาน ถ้าคลาดเคลื่อนมากเกินไป ร้านเปลี่ยนสินค้าให้ใหม่นะคะ" },
  { title: "ข้อจำกัดการผลิต: งานกระดาษพิมพ์ 2 ด้าน หน้า-หลังไม่ตรงกัน", content: "งานกระดาษพิมพ์ 2 ด้าน หน้า-หลังจะคลาดเคลื่อนไม่ตรงกันได้ ด้านหลังคลาดเคลื่อนได้ ±3-5 มม. ค่ะ ไม่แนะนำให้ออกแบบมีกรอบ หรือวางส่วนสำคัญใกล้ขอบที่ตัด เพราะงานที่ตัดออกมาจะดูเอียงหรือเบี้ยวชัดกว่างานที่ไม่มีกรอบนะคะ" },
  { title: "ข้อจำกัดการผลิต: สีงานพิมพ์เพี้ยนจากไฟล์ไหม สีแต่ละรอบเหมือนกันไหม", content: COLOR },
  { title: "ข้อจำกัดการผลิต: ตัดคลาดเคลื่อนกี่มิล ระยะตัดตก งานมีกรอบ", content: "งานตัดอาจคลาดเคลื่อน ±0.5-2 มม. จากข้อจำกัดของเครื่องตัดค่ะ งานกระดาษ/สติ๊กเกอร์มีระยะตัดตก 2-3 มม. งานที่มีเส้นกรอบหรือเล่นขอบจะคลาดเคลื่อน 1-3 มม. (บางงาน ±3-5 มม.) และจะหลอกตาให้ดูเอียงมากกว่าปกติ งานเคลือบลามิเนตอาจมีฝุ่นเล็กน้อยนะคะ" },
  { title: "ข้อจำกัดการผลิต: ที่คั่นหนังสือแม่เหล็ก", content: "ที่คั่นหนังสือแม่เหล็กมีระยะตัดตก 2-3 มม. ค่ะ และตอนตัดอาจมีขอบขาวบ้าง จากข้อจำกัดของเครื่องตัดนะคะ" },
  { title: "ข้อจำกัดการผลิต: งานฟอยล์ และ spot UV", content: "งานฟอยล์ที่จุดหรือเส้นเล็กเกินไปอาจติดไม่ครบค่ะ งาน spot UV + ฟอยล์ ถ้าจุดเล็ก เส้นเล็ก หรือเส้นชิดกันเกินไป อาจติดไม่ครบหรือเส้นรวมกันได้ งานฟอยล์คลาดเคลื่อนได้ 1-3 มม. (สกรีนด้านหลังได้ถึง 5 มม.) งานที่มีกรอบจะดูเอียง และงานเคลือบ spot UV อาจมีฝุ่นเล็กน้อยนะคะ" },
  { title: "ข้อจำกัดการผลิต: อะคริลิค ขนาดพวงกุญแจรวมรูไหม สกรีนบนหรือใต้", content: "ขนาดพวงกุญแจอะคริลิคที่สั่ง ไม่นับรวมรูตะขอค่ะ ถ้าต้องการให้นับรวมรบกวนแจ้งก่อนนะคะ ปกติร้านสกรีนใต้แผ่น (ยกเว้นอะคริลิคโฮโลแกรม01/สีพิเศษ ที่สกรีนบน) ถ้าต้องการสกรีนบนต้องแจ้ง ร้านจะเขียนกำกับไว้ในบิล ถ้าบิลไม่มีเขียนกำกับให้แจ้งทันที งานอะคริลิคเป็นงานพิมพ์ UV อาจมีฝุ่นลงงานเล็กน้อยนะคะ" },
  { title: "ข้อจำกัดการผลิต: ผ้าห่ม ผ้าเช็ดหน้า ผ้าขนหนู สำเร็จรูป (ไม่เน้นตำแหน่ง)", content: "ผ้าห่ม ผ้าเช็ดหน้า ผ้าขนหนูแบบเย็บสำเร็จรูป (ไม่เน้นตำแหน่งงานสกรีน) ตำแหน่งลายแต่ละผืนจะคลาดเคลื่อนจากแบบประมาณ 5-15 ซม. (3-7 นิ้ว) เพราะผ้าเย็บสำเร็จมาแล้วและบิดตอนม้วนเข้าเครื่อง แต่ละผืนขนาดไม่เท่ากัน ±0.5-5 นิ้ว สีแต่ละล็อตต่างกันเล็กน้อย ไม่แนะนำแบบที่มีกรอบ เส้นตรง หรือฟิกตำแหน่ง และอาจมีจุดจากฝุ่นบ้างนะคะ" },
  { title: "ข้อจำกัดการผลิต: ผ้าห่มแบบเน้นตำแหน่งงานสกรีน", content: "ผ้าห่มแบบเน้นตำแหน่งงานสกรีน ตำแหน่งลายคลาดเคลื่อนประมาณ ±0.5-2 นิ้ว แต่ละผืนขนาดไม่เท่ากัน ±0.5-2.5 นิ้ว สีแต่ละล็อตต่างกันเล็กน้อย อาจมีจุดจากฝุ่นบ้าง และงานพิมพ์ 2 ด้าน ด้านหลังอาจมีรอยเส้นหรือบั้งจากความร้อนตอนเข้าเครื่องรอบสองค่ะ" },
  { title: "ข้อจำกัดการผลิต: กระเป๋าผ้าดิบ สำเร็จรูป และสกรีนเต็มใบ", content: "กระเป๋าผ้าดิบแบบสำเร็จรูป สีผ้าแต่ละล็อตต่างกันเล็กน้อย ขนาดแต่ละใบคลาดเคลื่อน 0.5-2 นิ้วค่ะ ส่วนแบบสกรีนเต็มใบเย็บขึ้นใหม่ สีและความหนานุ่มของผ้าแต่ละล็อตไม่เท่ากัน ขนาดคลาดเคลื่อน 0.5-1 นิ้วนะคะ" },
  { title: "ข้อจำกัดการผลิต: ตุ๊กตา หมอนไดคัทตามทรง วัดขนาดยังไง", content: "ตุ๊กตาและหมอนไดคัทตามทรง ขนาดยึดตามด้านที่ยาวที่สุดและรวมขอบขาวค่ะ วัดจากขอบเย็บฝั่งหนึ่งถึงอีกฝั่งตามแบบ ด้วยสายวัดผ้าเท่านั้น (ไม่ใช้ตลับเมตร) ขนาดคลาดเคลื่อนได้ ±5-10 ซม. เพราะผ้าแต่ละชนิดยืดไม่เท่ากันตอนยัดใย และร้านแพ็คใส่ถุงสูญญากาศก่อนจัดส่งนะคะ" },
  { title: "ข้อจำกัดการผลิต: งานสกรีนซับลิเมชั่น ความคมชัด สีกลืนพื้นหลัง", content: "งานซับลิเมชั่น ผ้าแต่ละชนิดผิวต่างกัน ความคมชัดจึงไม่เท่ากัน ผ้าผิวเรียบจะคมและสีเข้มกว่าผ้าขนสั้น และจะรู้ผลหลังสกรีนเท่านั้นค่ะ งานนี้ถ่ายโอนสีด้วยความร้อน บางสีอาจกลืนกับพื้นหลังจนมองไม่เห็น เช่น ตัวอักษรสีอ่อนบนพื้นสีเข้ม ซึ่งบอกล่วงหน้าไม่ได้จนกว่าจะสกรีนออกมานะคะ" },
  { title: "ข้อจำกัดการผลิต: เคสมือถือกล้องสูง Griptok ฝุ่น คราบกาว", content: "เคสมือถือบางรุ่นที่กล้องสูง สีจะอ่อนหรือฟุ้งกว่าปกติ เพราะต้องยกหัวพิมพ์สูงขึ้นค่ะ Griptok เคลือบนูน (เรซิ่น) อาจมีฝุ่นเล็กน้อย ฐาน Griptok อาจติดไม่ตรงกลางเป๊ะแต่ไม่มีผลกับการใช้งาน งานพิมพ์ UV ทุกชนิดอาจมีฝุ่นลงงานเล็กน้อย ถ้าเยอะเกินไปร้านคัดออกและแก้ไขให้ทันที และงานที่ติดกาวอาจเห็นคราบกาวบ้างนะคะ" },
];

const existing = await col.get();
const titles = new Set(existing.docs.map((d) => String(d.data().title ?? "").trim()));
let added = 0, fixed = 0, pushed = 0;
for (const it of ADD) {
  if (titles.has(it.title)) { console.log("มีแล้ว ข้าม:", it.title); continue; }
  console.log(apply ? "เพิ่ม:" : "(จะเพิ่ม)", it.title);
  if (!apply) continue;
  await col.add({ title: it.title, content: it.content, type: "policy", source: SRC, ...BY, createdAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });
  added++;
  if (await pushKnowledge({ question: it.title, answer: it.content, type: "policy" })) pushed++;
}
// เรื่องสี: ข้อที่เพิ่งเพิ่ม/แก้วันนี้เป็น 5-10% → ให้ตรงหน้านโยบาย
const colorDocs = existing.docs.filter((d) => d.id === "SRdPxxXat6QVqYHG4ahj" || String(d.data().title ?? "") === "สีงานจริงจะตรงกับหน้าจอไหม สีเพี้ยนไหม");
for (const d of colorDocs) {
  const x = d.data();
  if (x.content === COLOR) { console.log("สีตรงแล้ว ข้าม:", d.id); continue; }
  console.log(apply ? "แก้สี:" : "(จะแก้สี)", d.id, String(x.title).slice(0, 40));
  if (!apply) continue;
  await d.ref.update({ content: COLOR, prevContent2: x.content ?? "", policyFix2: "สีตามหน้านโยบาย: เทียบไฟล์ ±5-15% · ต่างรอบ ±5-10%", updatedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });
  fixed++;
  if (await pushKnowledge({ question: String(x.title ?? ""), answer: COLOR, type: String(x.type || "policy") })) pushed++;
}
console.log(apply ? `✅ เพิ่ม ${added} · แก้สี ${fixed} · ส่งเข้า n8n สำเร็จ ${pushed}` : "(ลองดูเฉย ๆ — ใส่ --apply เพื่อบันทึก)");
