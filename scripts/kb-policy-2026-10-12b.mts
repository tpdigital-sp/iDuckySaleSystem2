/**
 * 📚 นโยบายร้านชุด 2 (เจ้าของร้านตอบ 12 ต.ค. 69) + ข้อเท็จจริงจากระบบ 4 ข้อ → knowledge-base (type "policy") + n8n knowledge-ingest
 *   รันซ้ำได้ (เช็คชื่อซ้ำ) · ใส่ --apply เพื่อบันทึก
 *   ค่าส่งอ่านจากหลังบ้านตอนเขียน (__shop_payment__: EMS 50 · EMS 100 เมื่อยอด ≥2,000 · ส่งฟรี ≥50,000 · มารับเอง 0) — เปลี่ยนค่าส่งแล้วรันสคริปต์นี้ซ้ำไม่ได้ผล ต้องแก้ข้อในคลังเอง
 */
import { FieldValue } from "firebase-admin/firestore";
import { getChatFirestore } from "../src/lib/server/firebase-admin";
import { pushKnowledge } from "../src/lib/server/bot-kb";

const apply = process.argv.includes("--apply");
const db = getChatFirestore();
if (!db) throw new Error("ยังไม่ได้ตั้งค่า Firestore");
const col = db.collection("knowledge-base");
const BY = { createdBy: "owner-policy", createdByName: "เจ้าของร้าน (12 ต.ค. 69 ชุด 2)" };

const ADD: { title: string; content: string }[] = [
  { title: "ยกเลิกออเดอร์หลังโอนเงินแล้ว ขอคืนเงินได้ไหม", content: "ขออภัยค่ะ ออเดอร์ที่ชำระเงินแล้วร้านไม่คืนเงินในกรณียกเลิกนะคะ รบกวนตรวจสอบรายละเอียดสินค้า จำนวน และแบบให้เรียบร้อยก่อนชำระเงินค่ะ" },
  { title: "สั่งไปแล้ว ขอเพิ่มจำนวนได้ไหม เพิ่มได้ถึงเมื่อไหร่", content: "เพิ่มจำนวนในออเดอร์เดิมได้จนกว่างานจะเริ่มผลิตค่ะ ระบบคิดราคาขั้นบันไดรวมทั้งบิลให้อัตโนมัติ จำนวนรวมเยอะขึ้นราคาต่อชิ้นก็ถูกลงด้วยนะคะ ถ้างานเริ่มผลิตแล้วจะเพิ่มในใบเดิมไม่ได้ ต้องเปิดออเดอร์ใหม่ค่ะ" },
  { title: "ร้านออกแบบให้ได้ไหม ค่าออกแบบเท่าไหร่", content: "ร้านออกแบบให้ได้ค่ะ ค่าออกแบบคิดตามความยากง่ายของงาน รบกวนส่งรายละเอียดหรือตัวอย่างงานที่ต้องการมา เดี๋ยวแอดมินตีราคาให้นะคะ" },
  { title: "แก้แบบได้กี่ครั้ง", content: "แก้แบบได้ไม่เกิน 3 ครั้งค่ะ รบกวนรวบรวมจุดที่ต้องการแก้แจ้งมาในครั้งเดียว จะได้ไม่เสียรอบนะคะ" },
  { title: "ใช้เวลาทำกี่วัน ได้ของกี่วัน ระยะเวลาทำแบบและผลิต", content: "กราฟิกทำแบบให้ภายใน 1-3 วันทำการ ขึ้นอยู่กับปริมาณงานช่วงนั้นค่ะ หลังลูกค้าอนุมัติแบบ ใช้เวลาผลิต 1-2 วันทำการ ขึ้นอยู่กับจำนวนที่สั่งด้วย ส่วนงานเรซิ่น (เคลือบนูน) ใช้เวลาผลิต 2-3 วันทำการ เพราะต้องรอเรซิ่นแห้งนะคะ ผลิตเสร็จแล้วส่ง EMS อีก 1-3 วันค่ะ (นับเฉพาะวันทำการ จันทร์-ศุกร์ ไม่รวมวันหยุดร้าน)" },
  { title: "ขอดูตัวอย่างงานจริงได้ไหม ส่งตัวอย่างให้ไหม", content: "มีตัวอย่างงานจริงค่ะ แต่ไม่ได้มีทุกสินค้านะคะ รบกวนแจ้งสินค้าที่อยากดู เดี๋ยวแอดมินเช็คให้ค่ะ ถ้ามีตัวอย่าง ลูกค้าชำระค่าจัดส่งเองนะคะ" },
  { title: "แอดมินตอบแชทกี่โมง ทักนอกเวลาได้ไหม", content: "แอดมินดูแลแชทในเวลาทำการ จันทร์-ศุกร์ 09.00-18.00 น. ค่ะ ทักนอกเวลาไว้ได้เลยนะคะ แอดมินจะตอบกลับในเวลาทำการถัดไปค่ะ" },
  { title: "เปลี่ยนที่อยู่จัดส่งได้ไหม แก้ที่อยู่หลังสั่ง", content: "แก้ที่อยู่จัดส่งเองได้ที่หน้าออเดอร์ของคุณลูกค้าค่ะ แก้ได้จนกว่าร้านจะปริ้นใบงาน ถ้าเลยขั้นนั้นแล้วรบกวนทักแอดมินนะคะ" },
  { title: "เลขพัสดุดูได้ที่ไหน ติดตามพัสดุยังไง", content: "พอร้านส่งของแล้ว เลขพัสดุจะขึ้นในหน้าออเดอร์ของคุณลูกค้า และระบบแจ้งทาง LINE ให้ด้วยค่ะ (ถ้าผูก LINE กับออเดอร์ไว้) กดเลขพัสดุเพื่อดูสถานะได้เลยนะคะ" },
  { title: "ขอใบเสนอราคาได้ไหม ทำใบเสนอราคายังไง", content: "ขอใบเสนอราคาได้ค่ะ รบกวนแจ้งรายการสินค้า สเปค จำนวน และชื่อ/ที่อยู่ที่ต้องการให้ขึ้นในเอกสาร เดี๋ยวแอดมินออกใบเสนอราคาเป็นลิงก์ส่งให้นะคะ ลูกค้าเปิดดู ตรวจรายการ และกดยืนยันสั่งซื้อจากลิงก์นั้นได้เลยค่ะ" },
  { title: "ค่าส่งเท่าไหร่ ส่งฟรีไหม", content: "ค่าส่ง EMS 50 บาทค่ะ ถ้ายอดสินค้าตั้งแต่ 2,000 บาท ค่าส่ง EMS 100 บาท (ระบบคิดให้อัตโนมัติในตะกร้า) ยอดสั่งครบ 50,000 บาทส่งฟรี และมารับเองที่ร้านไม่มีค่าส่งนะคะ งานบางชนิด เช่น ขนาด A3 มีค่ากล่อง/ค่าแพ็คเพิ่ม ระบบบวกให้ในตะกร้า ยอดในตะกร้าคือยอดจริงค่ะ" },
];

const existing = await col.get();
const titles = new Set(existing.docs.map((d) => String(d.data().title ?? "").trim()));
let added = 0, pushed = 0;
for (const it of ADD) {
  if (titles.has(it.title)) { console.log("มีแล้ว ข้าม:", it.title); continue; }
  console.log(apply ? "เพิ่ม:" : "(จะเพิ่ม)", it.title);
  if (!apply) continue;
  await col.add({ title: it.title, content: it.content, type: "policy", source: "owner-2026-10-12b", ...BY, createdAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });
  added++;
  if (await pushKnowledge({ question: it.title, answer: it.content, type: "policy" })) pushed++;
}
console.log(apply ? `✅ เพิ่ม ${added} · ส่งเข้า n8n สำเร็จ ${pushed}` : "(ลองดูเฉย ๆ — ใส่ --apply เพื่อบันทึก)");
