// ข้อเดิมที่ขัดกับคำตอบใหม่ → แก้ให้ตรง (เก็บของเดิมไว้)
const FIX: Record<string, { title?: string; content: string; why: string }> = {
  jHhK6HKqNX6BSi429Xvu: { content: ADD[4].content, why: "มัดจำ: เดิมไม่มีเงื่อนไขยอด 10,000 บาท" },
  SRdPxxXat6QVqYHG4ahj: { content: ADD[8].content, why: "สี: เดิม 5-15% · เจ้าของร้านว่า 5-10%" },
  "8MycW1ZQ5spu7DyPtmEe": { content: ADD[10].content, why: "เคลม: เดิม 7 วันหลังได้รับ ไม่มีเงื่อนไขวิดีโอ" },
  WEV6sIVfkqQ0a8zeNj45: { content: ADD[10].content, why: "เคลม: เดิมให้ถ่ายรูป ไม่มีเงื่อนไขวิดีโอ/ระยะเวลา" },
};

const existing = await col.get();
const titles = new Set(existing.docs.map((d) => String(d.data().title ?? "").trim()));
let added = 0, fixed = 0, pushed = 0;
for (const it of ADD) {
  if (titles.has(it.title)) { console.log("มีแล้ว ข้าม:", it.title); continue; }
  console.log(apply ? "เพิ่ม:" : "(จะเพิ่ม)", it.title);
  if (!apply) continue;
  await col.add({ title: it.title, content: it.content, type: "policy", source: "owner-2026-10-12", ...BY, createdAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });
  added++;
  if (await pushKnowledge({ question: it.title, answer: it.content, type: "policy" })) pushed++;
}
for (const [id, f] of Object.entries(FIX)) {
  const ref = col.doc(id);
  const snap = await ref.get();
  if (!snap.exists) { console.log("ไม่พบ:", id); continue; }
  const x = snap.data() ?? {};
  if (x.policyFix) { console.log("แก้ไปแล้ว ข้าม:", id); continue; }
  console.log(apply ? "แก้:" : "(จะแก้)", id, "—", f.why);
  if (!apply) continue;
  await ref.update({ content: f.content, prevTitle: x.title ?? "", prevContent: x.content ?? "", policyFix: f.why, updatedBy: BY.createdBy, updatedByName: BY.createdByName, updatedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });
  fixed++;
  if (await pushKnowledge({ question: String(x.title ?? ""), answer: f.content, type: String(x.type || "tip") })) pushed++;
}
console.log(apply ? `✅ เพิ่ม ${added} · แก้ ${fixed} · ส่งเข้า n8n สำเร็จ ${pushed}` : "(ลองดูเฉย ๆ — ใส่ --apply เพื่อบันทึก)");
